<?xml version="1.0" encoding="utf-8"?>
<!--
    Root layout: a custom GameView fills the screen with the HUD and on-screen
    D-pad on top, and three full-screen overlay layers (menu / pause / game
    over) above those. The overlays are semi-transparent, cover the whole
    screen and are clickable, so while one is visible it consumes all touches
    and the GameView / D-pad underneath are inert. MainActivity toggles their
    visibility to match the engine state (see DESIGN.md "Phase 3").
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <com.snakerush.ui.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        On-screen D-pad (second input method, alongside swipe). Both route to
        GameView.pressDirection(...). The GameView reserves board_bottom_reserve
        so the board sits above these buttons. Hidden whenever an overlay is
        shown (i.e. only visible while PLAYING).
    -->
    <LinearLayout
        android:id="@+id/dpad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnUp"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/dp_button"
            android:padding="0dp"
            android:text="▲"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLeft"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/dp_button"
                android:padding="0dp"
                android:text="◀"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnDown"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/dp_button"
                android:padding="0dp"
                android:text="▼"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnRight"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/dp_button"
                android:padding="0dp"
                android:text="▶"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- HUD: current score + persisted best score. Covered by the overlays. -->
    <LinearLayout
        android:id="@+id/scoreBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/scoreText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="@string/score_label" />

        <TextView
            android:id="@+id/bestScoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:text="@string/best_label" />
    </LinearLayout>

    <!-- ======================= Menu overlay ======================= -->
    <FrameLayout
        android:id="@+id/menuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_bg"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_title"
                android:textColor="@color/text_primary"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menuBestText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/menu_best_label"
                android:textColor="@color/accent"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/menu_difficulty_label"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEasy"
                    android:layout_width="88dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/overlay_button"
                    android:text="@string/difficulty_easy"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnNormal"
                    android:layout_width="88dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/overlay_button"
                    android:text="@string/difficulty_normal"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnHard"
                    android:layout_width="88dp"
                    android:layout_height="46dp"
                    android:background="@drawable/overlay_button"
                    android:text="@string/difficulty_hard"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnStart"
                android:layout_width="180dp"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/overlay_button"
                android:text="@string/action_start"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ======================= Pause overlay ======================= -->
    <FrameLayout
        android:id="@+id/pauseOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_bg"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pause_title"
                android:textColor="@color/text_primary"
                android:textSize="36sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnResume"
                android:layout_width="180dp"
                android:layout_height="52dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/overlay_button"
                android:text="@string/action_resume"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnPauseRestart"
                android:layout_width="180dp"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/overlay_button"
                android:text="@string/action_restart"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnPauseMenu"
                android:layout_width="180dp"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/overlay_button"
                android:text="@string/action_menu"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ======================= Game-over overlay ======================= -->
    <FrameLayout
        android:id="@+id/gameOverOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_bg"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/game_over_title"
                android:textColor="@color/text_primary"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gameOverScoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/overlay_score_label"
                android:textColor="@color/text_primary"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/gameOverBestText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/overlay_best_label"
                android:textColor="@color/accent"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnRestart"
                android:layout_width="180dp"
                android:layout_height="52dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/overlay_button"
                android:text="@string/action_restart"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnGameOverMenu"
                android:layout_width="180dp"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/overlay_button"
                android:text="@string/action_menu"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
